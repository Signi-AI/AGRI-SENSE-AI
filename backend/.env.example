# Copy this file to .env and fill in your own values.
# NEVER put real secrets in this file - it is committed to git.
# Local .env is gitignored; on Render set these as Environment variables instead.

APP_NAME="AGRI-SENSE AI"
DATABASE_NAME="your_database_name_here"
# Neon shape: postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
DATABASE_URL="your_database_url_here"
# Use a long random value (at least 32 characters).
SECRET_KEY="your_long_random_secret_key_here_min_32_chars"
ALGORITHM=HS256
EXPIRE_ACCESS_TOKEN=60

# External services (optional)
GROQ_API_KEY="your_groq_api_key_here"
OPENWEATHER_API_KEY="your_openweather_api_key_here"
GROQ_MODEL=openai/gpt-oss-120b

# Legacy compatibility. CORS stays open ("*") for Vercel preview URLs.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Security - emails that KEEP the admin role at startup (comma separated).
# If this is empty, legacy admin accounts are downgraded to farmer.
ADMIN_EMAILS=
# Only enable after SMTP is configured; otherwise new signups cannot verify.
REQUIRE_EMAIL_VERIFICATION=false
VERIFY_TOKEN_EXPIRE=1440
RESET_TOKEN_EXPIRE=30

# Email delivery (leave empty to disable verification/reset emails locally)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@agrisense.local

# Google / Firebase ID token verification and links inside emails
FIREBASE_PROJECT_ID=agri-sense-ai
GOOGLE_TOKENINFO_URL=https://oauth2.googleapis.com/tokeninfo
FRONTEND_URL=http://localhost:5173

# Rate limiting and lockout (per minute / per IP)
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=5
ML_RATE_LIMIT_PER_MINUTE=20
MAX_REQUEST_BYTES=1000000
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
